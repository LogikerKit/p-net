The generated test vectors and JSON oracle come from these checked models.
Serialization, compiler behavior and the native projection remain trusted
bridge components, tested separately by verify.mjs. -/
import Parser
import Recovery
open Lean AlarmAck

def parserJson (id : Nat) (c : Parser.Case) : Json := Json.mkObj [
  ("id", toJson id), ("status", statusJson c.status),
  ("separate", toJson c.separate), ("mutation", toJson c.mutation),
  ("accepted", toJson (Parser.accepted c)),
  ("block", toJson ((Parser.input c).1.map UInt8.toNat)),
  ("advertised", toJson (Parser.input c).2)]

def sendCode : Recovery.SendResult → Int
  | .full => 1 | .zero => 0 | .negative => -1

def recoveryJson (id : Nat) (c : Recovery.Case) : Json := Json.mkObj [
  ("id", toJson id), ("status", statusJson c.status),
  ("separate", toJson c.separate), ("send_result", toJson (sendCode c.result)),
  ("first_callbacks", toJson (Recovery.delivered (Recovery.first c).2)),
  ("retry_callbacks", toJson (Recovery.afterRetries c).2),
  ("next_sequence", toJson (Recovery.first c).1.expected)]

def statusC (s : Status) : String :=
  "{" ++ String.intercalate "," (s.bytes.map fun b => toString b.toNat) ++ "}"

def parserHeader : String :=
  "/* Generated by Emit.lean; do not edit. */\n#include <stdint.h>\n" ++
  "struct ParserCase { unsigned id; uint8_t status[4]; bool separate; unsigned mutation; bool accepted; };\n" ++
  "static const ParserCase parser_cases[] = {\n" ++
  String.intercalate "\n" (Parser.cases.zipIdx.map fun (c, id) =>
    "{" ++ toString id ++ "," ++ statusC c.status ++ "," ++ toString c.separate ++
    "," ++ toString c.mutation ++ "," ++ toString (Parser.accepted c) ++ "},") ++ "\n};\n"

def recoveryHeader : String :=
  "/* Generated by Emit.lean; do not edit. */\n#include <stdint.h>\n" ++
  "struct RecoveryCase { unsigned id; uint8_t status[4]; bool separate; int send_result; unsigned first_callbacks; unsigned retry_callbacks; unsigned next_sequence; };\n" ++
  "static const RecoveryCase recovery_cases[] = {\n" ++
  String.intercalate "\n" (Recovery.cases.zipIdx.map fun (c, id) =>
    "{" ++ toString id ++ "," ++ statusC c.status ++ "," ++ toString c.separate ++
    "," ++ toString (sendCode c.result) ++ "," ++
    toString (Recovery.delivered (Recovery.first c).2) ++ "," ++
    toString (Recovery.afterRetries c).2 ++ "," ++
    toString (Recovery.first c).1.expected ++ "},") ++ "\n};\n"

def main (args : List String) : IO Unit := do
  match args with
  | ["parser-header"] => IO.print parserHeader
  | ["recovery-header"] => IO.print recoveryHeader
  | ["parser-json"] =>
    for (c, id) in Parser.cases.zipIdx do IO.println (parserJson id c).compress
  | ["recovery-json"] =>
    for (c, id) in Recovery.cases.zipIdx do IO.println (recoveryJson id c).compress
  | _ => throw (IO.userError "Expected parser-header, recovery-header, parser-json or recovery-json")
